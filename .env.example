# Copy this file to .env and set the authorised sources you are permitted to use.
# PriceWise is live-only. With no source configured it shows no products and no placeholder prices.
PRICEWISE_FEEDS=[]

# Example authorised feed configuration:
# [
#   {
#     "id": "amazon-feed",
#     "name": "Amazon India authorised feed",
#     "retailerId": "amazon-in",
#     "retailerName": "Amazon India",
#     "endpoint": "https://partner.example/api/products",
#     "retailerDomains": ["amazon.in"],
#     "authEnv": "AMAZON_PAAPI_TOKEN",
#     "requestIntervalMs": 1000
#   }
# ]
# The endpoint must return JSON in the shape documented in README.md.
# If authEnv is set, PriceWise sends that environment variable as a Bearer token.
# Only fill in credentials you are authorised to use.

# Amazon India (Product Advertising API)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_TOKEN=

# Flipkart Affiliate API (required for live Flipkart prices)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Comma-separated queries used for the homepage when no search term is entered.
FLIPKART_DEFAULT_QUERIES=mobile,laptop,shoes,skincare,earbuds,fashion

# Myntra
MYNTRA_AFFILIATE_ID=
MYNTRA_AFFILIATE_TOKEN=

# Nykaa
NYKAA_AFFILIATE_ID=
NYKAA_AFFILIATE_TOKEN=

# DeoDap
DEODAP_FEED_URL=
DEODAP_FEED_TOKEN=

# Meesho
MEESHO_AFFILIATE_ID=
MEESHO_AFFILIATE_TOKEN=

# AJIO
AJIO_AFFILIATE_ID=
AJIO_AFFILIATE_TOKEN=

# Tata CLiQ
TATACLIQ_AFFILIATE_ID=
TATACLIQ_AFFILIATE_TOKEN=

# Croma
CROMA_AFFILIATE_ID=
CROMA_AFFILIATE_TOKEN=

# Reliance Digital
RELIANCE_DIGITAL_AFFILIATE_ID=
RELIANCE_DIGITAL_AFFILIATE_TOKEN=

# Vijay Sales
VIJAY_SALES_AFFILIATE_ID=
VIJAY_SALES_AFFILIATE_TOKEN=

# BigBasket
BIGBASKET_AFFILIATE_ID=
BIGBASKET_AFFILIATE_TOKEN=

# JioMart
JIOMART_AFFILIATE_ID=
JIOMART_AFFILIATE_TOKEN=

# Blinkit
BLINKIT_AFFILIATE_ID=
BLINKIT_AFFILIATE_TOKEN=

# Brand store feed
BRAND_FEED_URL=
BRAND_FEED_TOKEN=

PORT=3000
HOST=127.0.0.1
PRICEWISE_DB=./data/pricewise.sqlite
